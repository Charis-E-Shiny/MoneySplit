rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(g) { return signedIn() && request.auth.uid in g.memberIds; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      // Any signed-in user can look a group up (needed to join by invite code).
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.adminId == request.auth.uid;
      // Members can update. A non-member may only add THEMSELVES (joining).
      allow update: if isMember(resource.data)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid]));
      allow delete: if signedIn() && resource.data.adminId == request.auth.uid;

      match /requests/{rid} {
        allow read, write: if isMember(get(/databases/$(database)/documents/groups/$(gid)).data);
      }
      match /transactions/{tid} {
        allow read, write: if isMember(get(/databases/$(database)/documents/groups/$(gid)).data);
      }
    }
  }
}
